<div id="memberModal" class="fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-50">
  <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-md text-center">
    
    <% if !user_signed_in? %>
      <h2 class="text-3xl font-semibold mb-4 text-gray-900">This is a member's only website please login and buy membership for further usage.</h2>
      <p class="text-gray-700 mb-8 text-lg">You must sign in to continue.</p>
      <div class="flex flex-col space-y-4">
        <a href="<%= new_user_session_path %>" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-lg font-medium">Sign In</a>
        <a href="<%= new_user_registration_path %>" class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-lg font-medium">Sign Up</a>
      </div>

    <% else %>
      <h2 class="text-3xl font-semibold mb-4 text-gray-900">Membership Required</h2>
      <p class="text-gray-700 mb-8 text-lg">Please complete your membership payment to access this website.</p>
      <a href="<%= membership_payment_url(current_user.id) %>" class="px-6 py-3 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition text-lg font-medium">Pay Membership</a>
    <% end %>

  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.body.style.overflow = 'hidden'; // Prevent scrolling
  });
</script>
